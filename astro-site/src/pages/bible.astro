---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Bible Passage Lookup | Iglesia Canaan"
  description="Look up Scripture passages and read God's Word at Iglesia Canaan."
  active="bible"
>
  <section class="page-hero small-hero">
    <div class="container">
      <p class="section-tag">Scripture</p>
      <h1>Read God's Word.</h1>
      <p class="lead">Search and read exact Scripture passages directly from the Bible.</p>
    </div>
  </section>

  <section class="section bible-lookup-section">
    <div class="container bible-lookup-container">
      <div class="bible-mode-tabs" role="tablist" aria-label="Bible search mode">
        <button
          type="button"
          class="bible-mode-tab active"
          data-bible-mode-tab="reference"
          role="tab"
          aria-selected="true"
        >
          Reference Lookup
        </button>
        <button
          type="button"
          class="bible-mode-tab"
          data-bible-mode-tab="semantic"
          role="tab"
          aria-selected="false"
        >
          Search by Topic
        </button>
      </div>

      <div class="bible-mode-panel" data-bible-mode-panel="reference">
        <div class="bible-search-card">
          <form class="bible-search-form" data-bible-form>
            <label for="bible-input" class="bible-search-label">Enter a Bible Reference</label>
            <div class="bible-input-group">
              <input
                id="bible-input"
                type="text"
                class="bible-input"
                data-bible-input
                placeholder="e.g. John 3:16"
                autocomplete="off"
                required
              />
              <button type="submit" class="button primary" data-bible-submit>Look Up</button>
            </div>
          </form>

          <div class="bible-examples">
            <span class="bible-examples-label">Try an example:</span>
            <button type="button" class="bible-chip" data-example-ref="John 3:16">John 3:16</button>
            <button type="button" class="bible-chip" data-example-ref="Genesis 1:1">Genesis 1:1</button>
            <button type="button" class="bible-chip" data-example-ref="Psalm 23">Psalm 23</button>
            <button type="button" class="bible-chip" data-example-ref="Romans 8:28">Romans 8:28</button>
          </div>

          <p class="form-status bible-status" data-bible-status role="status" hidden></p>
        </div>

        <!-- Scripture Output Card -->
        <article class="bible-result-card" data-bible-result hidden>
          <div class="bible-result-header">
            <div>
              <h2 class="bible-result-title" data-result-ref></h2>
              <div class="bible-meta-tags" data-result-meta></div>
            </div>
            <span class="bible-version-badge" data-result-version></span>
          </div>

          <div class="bible-text-wrapper">
            <blockquote class="bible-text" data-result-text></blockquote>
          </div>

          <footer class="bible-result-footer">
            <p class="bible-copyright" data-result-copyright></p>
          </footer>
        </article>
      </div>

      <div class="bible-mode-panel" data-bible-mode-panel="semantic" hidden>
        <div class="bible-search-card">
          <form class="bible-search-form" data-semantic-form>
            <label for="bible-semantic-input" class="bible-search-label">Search Scripture by Topic</label>
            <div class="bible-input-group">
              <input
                id="bible-semantic-input"
                type="text"
                class="bible-input"
                data-semantic-input
                placeholder="e.g. grace, forgiveness, trusting God"
                autocomplete="off"
                required
              />
              <button type="submit" class="button primary" data-semantic-submit>Search</button>
            </div>
          </form>

          <div class="bible-examples">
            <span class="bible-examples-label">Try a topic:</span>
            <button type="button" class="bible-chip" data-semantic-example="grace">grace</button>
            <button type="button" class="bible-chip" data-semantic-example="forgiveness">forgiveness</button>
            <button type="button" class="bible-chip" data-semantic-example="loving your enemies">loving your enemies</button>
            <button type="button" class="bible-chip" data-semantic-example="trusting God during difficult times">trusting God during difficult times</button>
          </div>

          <p class="form-status bible-status" data-semantic-status role="status" hidden></p>
        </div>

        <!-- Semantic Search Results -->
        <div class="bible-semantic-results" data-semantic-results hidden></div>
      </div>
    </div>
  </section>

  <script slot="scripts" is:inline src="/js/supabase-config.js"></script>
  <script slot="scripts" is:inline src="/js/bible.js"></script>
  <script slot="scripts" is:inline src="/js/bible-semantic.js"></script>
</BaseLayout>
