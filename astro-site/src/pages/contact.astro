---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Iglesia Canaan"
  description="Contact Iglesia Canaan for prayer, service times, and church information."
  active="contact"
>
  <section class="page-hero small-hero">
    <div class="container">
      <p class="section-tag">Contact</p>
      <h1>We would love to connect with you.</h1>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-card">
        <h2>Visit or Reach Out</h2>
        <ul class="contact-list">
          <li><strong>Address:</strong> 4201 S Main St, Los Angeles</li>
          <li><strong>Phone:</strong> (323) 508-9240</li>
          <li><strong>Email:</strong> info@iglesiacanaan.org</li>
          <li><strong>Social:</strong> Facebook and Instagram</li>
        </ul>
      </div>

      <div class="contact-card">
        <h2>Service Times</h2>
        <ul class="contact-list">
          <li><strong>Sunday Lessons:</strong> Adults and youth · 10:00 AM - 11:00 AM</li>
          <li><strong>Worship & Service:</strong> 11:00 AM - 1:00 PM</li>
          <li><strong>Thursday:</strong> 7:00 PM - 9:00 PM</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
